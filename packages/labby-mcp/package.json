{
  "name": "@dinglebear/labby",
  "version": "1.16.0",
  "license": "AGPL-3.0-only",
  "description": "Rust MCP gateway with Code Mode, authentication, setup, logs, CLI, HTTP API, and operator web UI.",
  "homepage": "https://github.com/dinglebear-ai/labby#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinglebear-ai/labby.git",
    "directory": "packages/labby-mcp"
  },
  "bugs": {
    "url": "https://github.com/dinglebear-ai/labby/issues"
  },
  "mcpName": "ai.dinglebear/labby",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "labby-mcp": "bin/labby.js",
    "labby": "bin/labby.js"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/",
    "README.md",
    "LICENSE*",
    "package.json"
  ],
  "scripts": {
    "prepack": "node scripts/sync-readme.js",
    "postinstall": "node scripts/install.js",
    "test": "node --test",
    "check": "node --check bin/labby.js && node --check scripts/install.js && node --check lib/platform.js && node --check scripts/sync-readme.js && node --check scripts/check-package.js && node scripts/check-package.js",
    "prepublishOnly": "node scripts/check-package.js --release"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "labby",
    "lab",
    "mcp",
    "mcp-gateway",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "homelab",
    "rust",
    "cli",
    "http-api",
    "web-ui",
    "code-mode",
    "oauth",
    "log-search",
    "local-first",
    "automation"
  ],
  "author": {
    "name": "dinglebear.ai",
    "url": "https://dinglebear.ai"
  }
}
